# Copy to `.env` at the repo root and fill in. `.env` is gitignored.
# An already-set environment variable always wins over this file.

# --- GenAI (semantic extraction lane, sweep, agent) ----------------------
# Any ONE of these is enough; settings.py checks them in this order.
# Without a key the semantic lane REFUSES to run rather than silently
# substituting the research stub. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_GENAI_API_KEY=

# --- Explicit backend overrides (leave unset for production behaviour) ---
# NER_BACKEND=gliner          # gliner (production) | deterministic (research only)
# GENAI_MODE=offline          # forces the labelled research stub, knowingly
# EMB_BLOCK_ENABLED=0         # turn OFF the ER embedding blocking lane
#
# The lane is the second candidate generator in entity resolution: it proposes
# pairs that share no deterministic blocking key ("Bob Miller" / "Robert Miller
# Jr"). Turning it off means those pairs are never scored and never merged, so
# resolution recall stops being comparable across runs -- set it deliberately,
# not to quiet an error.
#
# It requires real embeddings and refuses to run under GENAI_MODE=offline: the
# offline stub hashes character shingles, and its true/false similarity
# distributions overlap, so no threshold separates them. notebooks/99_run_all.py
# sets this to 0 for you on an offline run, and says so in its output.
