# Copy to `settings.env` (gitignored) and fill in, or export these in your environment.
# Cell 1 prints which keys it found, masked, and accepts several common spellings of each.
#
# Needed only for PROVIDER = "azure". The default offline run replays
# fixtures/offline_extractions.json and calls nothing.
#
# For PROVIDER = "gemini" you do not need this file at all — paste the key straight
# into GEMINI_API_KEY in cell 1, or export GEMINI_API_KEY / GOOGLE_API_KEY.

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# The Azure *deployment name*, not the model family. Falls back to MODEL in cell 1.
AZURE_OPENAI_DEPLOYMENT=
